# Supabase Postgres — pooled connection (app runtime, port 6543)
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Postgres — direct connection (migrations only, port 5432)
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Server
PORT=4000

# Auth
JWT_SECRET="replace-with-a-long-random-string"

# WhatsApp API (reused from NR Industries integration)
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_ALERT_RECIPIENT=""

# Email (optional, Nodemailer)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
